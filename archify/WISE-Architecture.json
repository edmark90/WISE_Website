  "cards": [
    {
      "dot": "cyan",
      "title": "Client Layer",
      "items": [
        "Mobile App (Flutter) — citizen waste classification, schedule view, notifications",
        "Web Admin (Vanilla JS) — dashboard analytics, user/record management, announcements"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend API (FastAPI on Render)",
      "items": [
        "REST endpoints under /api with JWT Bearer auth",
        "Routers: auth, users, dashboard, waste-records, collection-schedules, notifications, ai-guides, reports, mobile-updates, prediction",
        "Rate limiting + CORS + custom error handling"
      ]
    },
    {
      "dot": "violet",
      "title": "AI Classification (On-Backend)",
      "items": [
        "MobileNetV2 TFLite model loaded once at startup",
        "POST /api/v1/predict accepts multipart image → returns category + confidence + probabilities",
        "Result persisted to waste_records for admin dashboard (fail-open)"
      ]
    },
    {
      "dot": "amber",
      "title": "Collection Operations",
      "items": [
        "Admin manages schedules in web → stored in collection_schedule",
        "Mobile views schedules with barangay filter & day grouping",
        "Background worker polls every 60s → emits Arriving/Arrived/Completed notifications"
      ]
    },
    {
      "dot": "rose",
      "title": "Notification Pipeline",
      "items": [
        "Manual announcements (admin) + auto-status (worker) → notifications table",
        "FCM push via Firebase Admin SDK (optional, env-config)",
        "Mobile receives via Firebase Messaging → shows local notification (flutter_local_notifications)",
        "Per-user read state in notification_reads; preferences in users table"
      ]
    },
    {
      "dot": "slate",
      "title": "Data & Storage",
      "items": [
        "TiDB Cloud (MySQL) — all relational data via SQLAlchemy",
        "Tables: users, waste_records, collection_schedule, collection_history, notifications, notification_reads, device_tokens, app_versions, app_update_announcements, ai_guides",
        "File uploads served statically at /uploads (profile images + waste photos)"
      ]
    }
  ]
}